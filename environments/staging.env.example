# ==============================================================================
# AudioFACTORY - Staging Environment Configuration (.env.staging)
# ==============================================================================

# Node / App Environment
NODE_ENV=production
VITE_APP_ENV=staging
PORT=3000

# Base URL & Domains
VITE_BASE_URL=https://staging.audiofactory.app
VITE_API_BASE_URL=https://staging.audiofactory.app/api

# AI Voice Generation Engines (Staging Keys)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Firebase Client Configuration (Staging Project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=audiofactory-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=audiofactory-staging
VITE_FIREBASE_STORAGE_BUCKET=audiofactory-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Server Admin SDK (Staging)
FIREBASE_PROJECT_ID=audiofactory-staging
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Play In-App Billing (Internal Test Track)
GOOGLE_PLAY_PACKAGE_NAME=com.audiofactory.app
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=

# Stripe Billing (Staging / Test Mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Liveblocks Real-time Collaboration (Staging)
LIVEBLOCKS_SECRET_KEY=
VITE_LIVEBLOCKS_PUBLIC_KEY=
