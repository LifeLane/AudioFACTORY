# ==============================================================================
# AudioFACTORY - Production Environment Configuration (.env.production)
# ==============================================================================

# Node / App Environment
NODE_ENV=production
VITE_APP_ENV=production
PORT=3000

# Base URL & Domains
VITE_BASE_URL=https://audiofactory.app
VITE_API_BASE_URL=https://audiofactory.app/api

# AI Voice Generation Engines (Production High-Throughput Keys)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Firebase Client Configuration (Production Project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=audiofactory-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=audiofactory-prod
VITE_FIREBASE_STORAGE_BUCKET=audiofactory-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Server Admin SDK (Production)
FIREBASE_PROJECT_ID=audiofactory-prod
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Play In-App Billing (Production Store)
GOOGLE_PLAY_PACKAGE_NAME=com.audiofactory.app
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=

# Stripe Billing (Production Live Mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Liveblocks Real-time Collaboration (Production)
LIVEBLOCKS_SECRET_KEY=
VITE_LIVEBLOCKS_PUBLIC_KEY=
