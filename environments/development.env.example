# ==============================================================================
# AudioFACTORY - Development Environment Configuration (.env.development)
# ==============================================================================

# Node / App Environment
NODE_ENV=development
VITE_APP_ENV=development
PORT=3000

# Base URL & Domains
VITE_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api

# AI Voice Generation Engines (Development / Sandbox Keys)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Firebase Client Configuration (Development Project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=audiofactory-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=audiofactory-dev
VITE_FIREBASE_STORAGE_BUCKET=audiofactory-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Server Admin SDK (Development)
FIREBASE_PROJECT_ID=audiofactory-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Play In-App Billing (Testing / Sandbox)
GOOGLE_PLAY_PACKAGE_NAME=com.audiofactory.app.debug
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=

# Liveblocks Real-time Collaboration (Optional)
LIVEBLOCKS_SECRET_KEY=
VITE_LIVEBLOCKS_PUBLIC_KEY=
