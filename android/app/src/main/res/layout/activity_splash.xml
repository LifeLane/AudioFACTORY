<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D1117"
    android:padding="24dp">

    <!-- AudioFACTORY Brand Header -->
    <TextView
        android:id="@+id/splashLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AudioFACTORY"
        android:textColor="#F59E0B"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:layout_marginBottom="16dp" />

    <!-- Indeterminate Brand Progress Loader -->
    <ProgressBar
        android:id="@+id/splashLoader"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#F59E0B"
        android:layout_marginBottom="16dp" />

    <!-- Monospace Connection Label -->
    <TextView
        android:id="@+id/splashStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONNECTING TO STUDIO..."
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1" />

</LinearLayout>
