rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestampString(ts) {
      return ts is string && ts.size() >= 10 && ts.size() <= 50;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Projects validation
    function isValidAudioProject(data, authUid) {
      return data.userId is string && data.userId == authUid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000))
        && (!('format' in data) || (data.format is string && data.format.size() <= 100))
        && (!('style' in data) || (data.style is string && data.style.size() <= 100))
        && (!('speakerCount' in data) || (data.speakerCount is number && data.speakerCount >= 0 && data.speakerCount <= 50))
        && (!('speakers' in data) || (data.speakers is list && data.speakers.size() <= 20))
        && (!('lines' in data) || (data.lines is list && data.lines.size() <= 200))
        && isValidTimestampString(data.createdAt)
        && isValidTimestampString(data.updatedAt)
        // Prohibit privilege escalation, plan spoofing or foreign billing keys injected into project documents
        && !('plan' in data)
        && !('planId' in data)
        && !('role' in data)
        && !('isAdmin' in data)
        && !('admin' in data)
        && !('credits' in data)
        && !('quota' in data);
    }

    // Monologues validation
    function isValidAudioMonologue(data, authUid) {
      return data.userId is string && data.userId == authUid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.text is string && data.text.size() > 0 && data.text.size() <= 8000
        && (!('styleId' in data) || (data.styleId is string && data.styleId.size() <= 100))
        && (!('voice' in data) || (data.voice is string && data.voice.size() <= 100))
        && isValidTimestampString(data.createdAt)
        && isValidTimestampString(data.updatedAt)
        // Prohibit privilege escalation keys
        && !('plan' in data)
        && !('planId' in data)
        && !('role' in data)
        && !('isAdmin' in data)
        && !('admin' in data)
        && !('credits' in data)
        && !('quota' in data);
    }

    // User Profile validation
    function isValidUserProfile(data, authUid) {
      return data.userId is string && data.userId == authUid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('favoriteVoice' in data) || (data.favoriteVoice is string && data.favoriteVoice.size() <= 100))
        && (!('defaultProvider' in data) || (data.defaultProvider in ['gemini', 'elevenlabs']))
        && isValidTimestampString(data.updatedAt)
        && (!('createdAt' in data) || isValidTimestampString(data.createdAt))
        // Strictly prevent clients from self-assigning admin or subscription privileges
        && !('role' in data)
        && !('isAdmin' in data)
        && !('admin' in data)
        && !('plan' in data)
        && !('planId' in data)
        && !('entitlement' in data)
        && !('quota' in data)
        && !('credits' in data);
    }

    function isValidEarlyAccessRequest(data, authUid) {
      return data.userId is string && data.userId == authUid
        && data.email is string && data.email.size() <= 200
        && data.planId is string && data.planId.size() <= 100
        && data.status in ['pending', 'approved', 'rejected']
        && isValidTimestampString(data.createdAt)
        && isValidTimestampString(data.updatedAt);
    }

    match /earlyAccessRequests/{requestId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(incoming().userId) && isValidId(requestId)
        && isValidEarlyAccessRequest(incoming(), request.auth.uid)
        && incoming().status == 'pending';
      allow update: if isAdmin() && isValidEarlyAccessRequest(incoming(), existing().userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if false; // Only updated via backend
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId) || isAdmin();

      // User Projects (Multi-speaker dialogues)
      match /projects/{projectId} {
        allow get, delete: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId)
          && isValidAudioProject(incoming(), request.auth.uid);
        allow update: if isOwner(userId) && isValidId(projectId)
          && isValidAudioProject(incoming(), request.auth.uid)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
      }

      // User Monologues (Single speaker scripts)
      match /monologues/{monologueId} {
        allow get, delete: if isOwner(userId) && isValidId(monologueId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(monologueId)
          && isValidAudioMonologue(incoming(), request.auth.uid);
        allow update: if isOwner(userId) && isValidId(monologueId)
          && isValidAudioMonologue(incoming(), request.auth.uid)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
      }

      // User Profile & Studio Preferences
      match /profile/{profileId} {
        allow get: if isOwner(userId) && isValidId(profileId);
        allow create: if isOwner(userId) && isValidId(profileId)
          && isValidUserProfile(incoming(), request.auth.uid);
        allow update: if isOwner(userId) && isValidId(profileId)
          && isValidUserProfile(incoming(), request.auth.uid)
          && incoming().userId == existing().userId
          && (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt);
        allow delete: if false;
      }

      // Server-Controlled Collection: Usage Tracking & Daily Quotas
      // Clients may read their own records, but writes are strictly denied.
      // All usage and quota increments must originate from trusted backend code.
      match /usage/{dateId} {
        allow get: if isOwner(userId) && isValidId(dateId);
        allow list: if isOwner(userId);
        allow write: if false;
      }

      // Server-Controlled Collection: Entitlements & Subscription Status
      // Clients may read their own active entitlement, but writes are strictly denied.
      // All plan resolution and entitlement grants must originate from trusted backend code.
      match /entitlements/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow write: if false;
      }

      // Server-Controlled Collection: In-App Purchases & Audit Logs
      // Clients may read their verified purchases, but writes are strictly denied.
      // All purchase verifications and audit records must originate from trusted backend code.
      match /purchases/{purchaseId} {
        allow get: if isOwner(userId) && isValidId(purchaseId);
        allow list: if isOwner(userId);
        allow write: if false;
      }

      // Server-Controlled Collection: Generation Jobs History
      // Clients may read their generation job records, but direct writes are denied.
      // Generation jobs are queued, processed, and marked completed/failed exclusively by the trusted backend API.
      match /generationJobs/{jobId} {
        allow get: if isOwner(userId) && isValidId(jobId);
        allow list: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
